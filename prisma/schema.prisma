generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int            @id @default(autoincrement())
  indexNumber  String?        @unique
  username     String?        @unique
  name         String
  passwordHash String
  role         Role           @default(USER)
  createdAt    DateTime       @default(now())
  progress     UserProgress[]

  @@index([role])
}

enum Role {
  USER
  ADMIN
}

model QuizLevel {
  id         Int            @id @default(autoincrement())
  uuid       String         @unique @db.Char(36)
  title      String
  levelOrder Int
  isActive   Boolean        @default(true)
  questions  QuizQuestion[]

  @@index([isActive, levelOrder])
}

model QuizQuestion {
  id            Int            @id @default(autoincrement())
  quizLevelId   Int
  questionText  String         @db.Text
  answerKey     String
  questionOrder Int
  quizLevel     QuizLevel      @relation(fields: [quizLevelId], references: [id], onDelete: Cascade)
  progress      UserProgress[]

  @@index([quizLevelId], map: "QuizQuestion_quizLevelId_fkey")
}

model UserProgress {
  id         Int          @id @default(autoincrement())
  userId     Int
  questionId Int
  passedAt   DateTime
  isCorrect  Boolean      @default(false)
  question   QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
  @@index([questionId], map: "UserProgress_questionId_fkey")
  @@index([userId, isCorrect])
  @@index([userId])
}
